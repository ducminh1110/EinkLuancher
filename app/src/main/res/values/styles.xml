<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure white, no wallpaper, no window animations: best for e-paper. -->
    <style name="Theme.Eink" parent="@android:style/Theme.Holo.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackgroundCacheHint">@android:color/white</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Theme.Eink.Reader">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Dialog.Eink" parent="@android:style/Theme.Holo.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
